POSTGRES_DB=facturaelectronica
POSTGRES_USER=factura_user
POSTGRES_PASSWORD=change_me
DB_URL=jdbc:postgresql://postgres:5432/facturaelectronica
DB_USERNAME=factura_user
DB_PASSWORD=change_me
DB_POOL_MAX_SIZE=2
DB_POOL_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000
DB_MAX_LIFETIME_MS=300000
JPA_SHOW_SQL=false

TENANT_SERVICE_URL=http://tenant-service:8084
IDENTITY_SERVICE_URL=http://identity-service:8092
CATALOG_SERVICE_URL=http://catalog-service:8085
THIRDPARTY_SERVICE_URL=http://thirdparty-service:8086
INVENTORY_SERVICE_URL=http://inventory-service:8087
BILLING_SERVICE_URL=http://billing-service:8088
DIAN_PROVIDER_SERVICE_URL=http://dian-provider-service:8089
ACCOUNTING_SERVICE_URL=http://accounting-service:8090
AUDIT_SERVICE_URL=http://audit-service:8091
PAYROLL_SERVICE_URL=http://payroll-service:8093
REPORTING_SERVICE_URL=http://reporting-service:8094

APP_ENV=free-preview
APP_PUBLIC_BASE_URL=https://app.nexofiscal.online
FRONTEND_BASE_URL=https://app.nexofiscal.online
AUTH_MODE=local
BFF_CSRF_ENABLED=true
BFF_COOKIE_SECURE=true
BFF_COOKIE_SAME_SITE=Strict
BFF_SESSION_STORE=jdbc
BFF_SESSION_ENCRYPTION_KEY=change_me

IDENTITY_ROOT_USER_SEED_ENABLED=true
IDENTITY_ROOT_USER_EMAIL=root@example.com
IDENTITY_ROOT_USER_FULL_NAME=Root Platform User
IDENTITY_ROOT_USER_PASSWORD=change_me

TENANT_BRANDING_STORAGE_PATH=/var/nexofiscal/tenant-branding
TENANT_FILES_STORAGE_PROVIDER=local
TENANT_FILES_STORAGE_PATH=/var/nexofiscal/company-files
TENANT_FILES_DOWNLOAD_TOKEN_SECRET=change_me
REPORT_EXPORT_LOCAL_STORAGE_PATH=/var/nexofiscal/report-exports
REPORT_EXPORT_WORKER_ENABLED=true
REPORT_EXPORT_RETENTION_DAYS=7

DIAN_PROVIDER_MODE=mock
DIAN_PROVIDER_SECRETS_ENVIRONMENT=free-preview
DIAN_MOCK_DEFAULT_STATUS=ACCEPTED
EVENTING_EVENTBRIDGE_ENABLED=false
AWS_REGION=us-east-1
MANAGEMENT_HEALTH_SHOW_DETAILS=never
PREVIEW_HTTP_PORT=80
PREVIEW_RUNTIME_ENV_FILE=runtime.env
