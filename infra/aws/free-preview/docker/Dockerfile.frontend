FROM node:22-alpine AS build
WORKDIR /workspace
COPY apps/facturaelectronica-web/package.json apps/facturaelectronica-web/package-lock.json ./
RUN npm ci
COPY apps/facturaelectronica-web/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY infra/aws/free-preview/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/dist /usr/share/nginx/html
EXPOSE 8080

