  EventBus --> AuditQueue --> AuditLambda
  EventBus --> InventoryQueue --> InventoryLambda
  EventBus --> AccountingQueue --> AccountingLambda
  EventBus --> ProviderQueue --> ProviderRetryLambda
  EventBus --> ReportingQueue --> ReportingLambda

  AuditLambda --> Inbox
