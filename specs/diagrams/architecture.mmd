flowchart TB
  Browser[Browser / SPA]

  subgraph PublicEdge["Public edge"]
    CloudFront[CloudFront + security headers]
    S3[S3 private SPA assets]
    Cognito[Cognito Hosted UI + PKCE]
    ApiGateway[API Gateway / public ALB]
  end

  subgraph PrivateCompute["Private ECS Fargate services"]
    Bff[bff-service]
    Readiness[company-readiness composition]
    Tenant[tenant-service]
    Identity[identity-service]
    Catalog[catalog-service]
    ThirdParty[thirdparty-service]
    Inventory[inventory-service]
    Billing[billing-service]
    DianProvider[dian-provider-service / DIAN connector]
    Accounting[accounting-service]
    Audit[audit-service]
    Payroll[payroll-service]
    Reporting[reporting-service]
    Observability[business-health facade]
  end

  subgraph DataPlane["Private data plane"]
    RdsProxy[RDS Proxy]
    Rds[(RDS / Aurora PostgreSQL)]
    AssetBucket[S3 private company files / reports / POS artifacts]
    Secrets[Secrets Manager]
    Kms[KMS]
  end

  subgraph Eventing["AWS managed eventing"]
    Outbox[(Service Outbox tables)]
    EventBus[EventBridge custom bus]
    AuditQueue[SQS audit-events + DLQ]
    InventoryQueue[SQS inventory-effects + DLQ]
    AccountingQueue[SQS accounting-effects + DLQ]
    ProviderQueue[SQS provider-retries + DLQ]
    ReportingQueue[SQS reporting-projections + DLQ]
    ReportExportQueue[SQS report-export-jobs + DLQ]
    AuditLambda[audit-event-writer Lambda]
    InventoryLambda[inventory-sale-effect Lambda]
    AccountingLambda[accounting-effect Lambda]
    ProviderRetryLambda[provider-submission-retry Lambda]
    ReportingLambda[reporting-projection Lambda]
    ReportExportLambda[report-export-worker Lambda]
    Inbox[(Consumer Inbox tables)]
  end

  subgraph Notifications["AWS notifications"]
    Ses[SES report notifications]
  end

  subgraph ExternalDian["External DIAN responsibility"]
    CompanyCertificate[Company DIAN certificate / credentials]
    DianPlatform[DIAN services configured by company]
  end

  subgraph DianRealFlow["DIAN real flow inside dian-provider-service"]
    UblBuilder[UBL 2.1 XML builder]
    DianIdentifiers[CUFE / CUDE / QR calculator]
    XmlSigner[Company certificate XML signer]
    DianValidator[XSD / Schematron / code-list validator]
    DianTransport[DIAN habilitation / production transport]
    DianArtifacts[Private fiscal artifacts]
  end

  subgraph CompanyFiles["Company file storage"]
    FileMetadata[tenant.company_file_asset metadata]
    FilePrefixes[company/category prefixes]
    MockReceiptQr[Configurable mock receipt QR]
    MinioLocal[Local S3-compatible storage / MinIO optional]
  end

  subgraph OpsReadiness["Fase 35 readiness comercial"]
    SetupWizard[Company setup wizard]
    SecurityHardening[Production security hardening]
    AccountingReadiness[Accounting readiness]
    BusinessReports[Normalized business reports]
    PosPrinter[POS thermal bridge target]
    HealthMetrics[Actuator health / metrics / traces]
  end

