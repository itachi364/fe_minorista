  COMPANY {
    uuid id PK
    int identification_type_code
    varchar identification_number
    varchar verification_digit
    varchar legal_name
    varchar status
  }

  COMPANY_BRANDING {
    uuid company_id PK
    varchar display_name
    varchar main_logo_storage_key
    varchar header_logo_storage_key
    varchar login_logo_storage_key
    varchar favicon_storage_key
    varchar main_logo_hash
    varchar favicon_hash
  }

  COMPANY_LICENSE {
    uuid id PK
    uuid company_id FK
    date starts_at
    date expires_at
    varchar status
    json enabled_modules
    int max_users
    int max_monthly_documents
  }

  USER_ACCOUNT {
    uuid id PK
    varchar email
    varchar full_name
    varchar password_hash
    varchar cognito_subject
    varchar status
  }

  COMPANY_ROLE {
    uuid id PK
    uuid company_id FK
    varchar name
    varchar status
  }

  THIRD_PARTY {
    uuid id PK
    uuid company_id FK
    json roles
    varchar person_type
    int identification_type_code
    varchar identification_number
    varchar verification_digit
    varchar business_name
    varchar full_name
  }

  CATALOG_ITEM {
    uuid id PK
    varchar catalog_code
    varchar item_code
    varchar label
    boolean regulatory
    boolean active
  }

  PRODUCT {
    uuid id PK
    uuid company_id FK
    varchar sku
    varchar barcode
    varchar item_type
    varchar name
    numeric sale_price
    varchar tax_code
    numeric tax_rate
    boolean stock_tracked
  }

  INVENTORY_MOVEMENT {
    uuid id PK
    uuid company_id FK
    uuid product_id FK
    varchar movement_type
    numeric quantity
    numeric resulting_stock
    varchar source_document_type
    uuid source_document_id
  }

  SALE {
    uuid id PK
    uuid company_id FK
    uuid buyer_third_party_id FK
    varchar buyer_identification_mode
    varchar payment_method_code
    numeric total
    varchar status
  }

  ELECTRONIC_DOCUMENT {
    uuid id PK
    uuid company_id FK
    uuid sale_id FK
    varchar document_type
    varchar prefix
    bigint number
    varchar cufe_cude
    numeric total
    varchar status
  }

  ELECTRONIC_DOCUMENT_ARTIFACT {
    uuid id PK
    uuid company_id FK
    uuid document_id FK
    varchar artifact_type
    varchar storage_key
    varchar content_hash
    timestamp generated_at
  }

  POS_PRINT_JOB {
    uuid id PK
    uuid company_id FK
    uuid document_id FK
    int paper_width_mm
    varchar strategy
    varchar status
    timestamp requested_at
  }

  PROVIDER_CONFIGURATION {
    uuid id PK
    uuid company_id FK
    varchar mode
    varchar environment
    varchar certificate_secret_ref
    varchar software_pin_secret_ref
    varchar technical_key_secret_ref
    varchar status
  }

  ACCOUNTING_ENTRY {
    uuid id PK
    uuid company_id FK
    date entry_date
    varchar source_type
    uuid source_id
    varchar status
  }

  PAYROLL_SETTINGS {
    uuid id PK
    uuid company_id FK
    boolean electronic_payroll_enabled
  }

  WEB_SESSION {
    uuid id PK
    uuid user_id FK
    varchar session_token_hash
    varchar csrf_token_hash
    varchar status
    timestamp expires_at
  }

  AUDIT_EVENT {
    uuid id PK
    uuid company_id FK
    uuid user_id FK
    varchar event_type
    varchar resource_type
    varchar action
    varchar result
    timestamp occurred_at
  }

  OUTBOX_EVENT {
    uuid event_id PK
    uuid company_id FK
    varchar event_type
    varchar status
    timestamp occurred_at
  }

  INBOX_EVENT {
    uuid id PK
    uuid event_id
    uuid company_id FK
    varchar consumer
    varchar status
  }

  REPORT_DEFINITION {
    varchar code PK
    varchar label
    boolean date_range_required
    json allowed_chart_types
    json export_formats
    boolean active
  }

  REPORT_EXECUTION {
    uuid id PK
    uuid company_id FK
    varchar report_code FK
    date from_date
    date to_date
    json filters_json
    varchar status
  }

  REPORT_EXPORT {
    uuid id PK
    uuid company_id FK
    varchar report_code FK
    varchar format
    varchar storage_key
    varchar status
    timestamp expires_at
  }
