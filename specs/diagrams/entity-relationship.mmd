  COMPANY {
    uuid id PK
    varchar legal_name
    varchar identification_number
    varchar status
  }

  USER_ACCOUNT {
    uuid id PK
    varchar username
    varchar email
    varchar password_hash
    varchar status
  }

  PRODUCT {
    uuid id PK
    uuid company_id FK
    uuid category_id FK
    varchar barcode
    varchar name
    numeric sale_price
    boolean active
  }

  STOCK_BALANCE {
    uuid id PK
    uuid company_id FK
    uuid product_id FK
    numeric current_stock
    numeric reserved_stock
  }

  INVENTORY_MOVEMENT {
    uuid id PK
    uuid company_id FK
    uuid product_id FK
    varchar movement_type
    numeric quantity
    numeric previous_stock
    numeric resulting_stock
    varchar source_type
    uuid source_id
  }

  SALE {
    uuid id PK
    uuid company_id FK
    uuid customer_id FK
    varchar sale_channel
    numeric total
    varchar status
  }

  ELECTRONIC_DOCUMENT {
    uuid id PK
    uuid company_id FK
    uuid sale_id FK
    varchar document_type
    varchar prefix
    bigint number
    varchar cufe_cude
    numeric total
    varchar status
  }

  NUMBERING_RESOLUTION {
    uuid id PK
    uuid company_id FK
    varchar document_type
    varchar resolution_number
    varchar prefix
    bigint from_number
    bigint to_number
    bigint current_number
    date valid_from
    date valid_to
  }

  ACCOUNT {
    uuid id PK
    uuid company_id FK
    varchar code
    varchar name
    varchar nature
  }

  ACCOUNTING_ENTRY {
    uuid id PK
    uuid company_id FK
    date entry_date
    varchar source_type
    uuid source_id
    varchar status
  }
