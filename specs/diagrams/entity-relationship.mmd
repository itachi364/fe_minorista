  COMPANY {
    uuid id PK
    int identification_type_code
    varchar identification_number
    varchar verification_digit
    varchar legal_name
    varchar status
  }

  COMPANY_BRANDING {
    uuid company_id PK
    varchar display_name
    varchar primary_color
    varchar accent_color
    varchar main_logo_storage_key
    varchar header_logo_storage_key
    varchar login_logo_storage_key
    varchar favicon_storage_key
    varchar main_logo_hash
    varchar favicon_hash
  }

  COMPANY_FILE_ASSET {
    uuid id PK
    uuid company_id FK
    varchar business_category
    varchar storage_provider
    varchar storage_reference
    varchar safe_file_name
    varchar content_type
    bigint size_bytes
    varchar content_hash
    varchar status
  }

  COMPANY_READINESS_SNAPSHOT {
    uuid id PK
    uuid company_id FK
    varchar overall_status
    timestamp evaluated_at
    uuid evaluated_by FK
    varchar correlation_id
  }

  COMPANY_READINESS_CHECK {
    uuid id PK
    uuid snapshot_id FK
    varchar check_code
    varchar module_code
    varchar status
    boolean blocking
    varchar action_code
  }

  COMPANY_LICENSE {
    uuid id PK
    uuid company_id FK
    date starts_at
    date expires_at
    varchar status
    json enabled_modules
    int max_users
    int max_monthly_documents
  }

  USER_ACCOUNT {
    uuid id PK
    varchar email
    varchar full_name
    varchar password_hash
    varchar cognito_subject
    varchar status
  }

  COMPANY_ROLE {
    uuid id PK
    uuid company_id FK
    varchar name
    varchar status
  }

  THIRD_PARTY {
    uuid id PK
    uuid company_id FK
    json roles
    varchar person_type
    int identification_type_code
    varchar identification_number
    varchar verification_digit
    varchar business_name
    varchar full_name
  }

  CATALOG_ITEM {
    uuid id PK
    varchar catalog_code
    varchar item_code
    varchar label
    boolean regulatory
    boolean active
  }

  PRODUCT {
    uuid id PK
    uuid company_id FK
    varchar sku
    varchar barcode
    varchar item_type
    varchar name
    numeric sale_price
    varchar tax_code
    numeric tax_rate
    boolean stock_tracked
    boolean active
  }

  PURCHASE {
    uuid id PK
    uuid company_id FK
    uuid supplier_id FK
    date purchase_date
    varchar concept
    varchar payment_method_code
    varchar status
    numeric total
    varchar evidence_type
    uuid evidence_file_asset_id FK
    varchar evidence_url
  }

  PURCHASE_LINE {
    uuid id PK
    uuid purchase_id FK
    uuid product_id FK "optional historical reference"
    varchar description
    numeric line_total
  }

  INVENTORY_MOVEMENT {
    uuid id PK
    uuid company_id FK
    uuid product_id FK
    varchar movement_type
    numeric quantity
    numeric resulting_stock
    varchar source_document_type
    uuid source_document_id
  }

  ISSUER_PROFILE {
    uuid id PK
    uuid company_id FK
    varchar identification_number
    varchar legal_name
    varchar environment
    boolean active
  }

  NUMBERING_RESOLUTION {
    uuid id PK
    uuid company_id FK
    varchar document_type
    varchar resolution_number
    varchar prefix
    bigint from_number
    bigint to_number
    bigint current_number
    varchar environment
    boolean active
  }

  FINAL_CONSUMER_PROFILE {
    uuid id PK
    uuid company_id FK
    varchar profile_code
    varchar identification_number
    varchar display_name
    boolean active
  }

  SALE {
    uuid id PK
    uuid company_id FK
    uuid buyer_third_party_id FK
    varchar buyer_identification_mode
    varchar payment_method_code
    numeric total
    varchar status
  }

  ELECTRONIC_DOCUMENT {
    uuid id PK
    uuid company_id FK
    uuid sale_id FK
    varchar document_type
    varchar prefix
    bigint number
    varchar cufe_cude
    varchar qr_content
    numeric total
    varchar status
  }

  ELECTRONIC_DOCUMENT_ARTIFACT {
    uuid id PK
    uuid company_id FK
    uuid document_id FK
    varchar artifact_type
    varchar storage_key
    varchar content_hash
    timestamp generated_at
  }

  POS_PRINT_JOB {
    uuid id PK
    uuid company_id FK
    uuid document_id FK
    int paper_width_mm
    varchar strategy
    varchar status
    timestamp requested_at
  }

  PROVIDER_CONFIGURATION {
    uuid id PK
    uuid company_id FK
    varchar mode
    varchar environment
    varchar wsdl_url
    varchar service_base_url
    varchar certificate_secret_ref
    varchar certificate_file_type
    varchar certificate_fingerprint
    varchar software_pin_secret_ref
    varchar technical_key_secret_ref
    varchar test_set_id
    varchar status
  }

  DIAN_SUBMISSION_EVENT {
    uuid id PK
    uuid company_id FK
    uuid submission_id FK
    uuid document_id FK
    varchar event_type
    varchar status
    varchar dian_code
    varchar correlation_id
  }

  DIAN_SUBMISSION_ARTIFACT {
    uuid id PK
    uuid company_id FK
    uuid submission_id FK
    uuid document_id FK
    varchar artifact_type
    varchar storage_key
    varchar content_hash
  }

  DIAN_TECHNICAL_VALIDATION_RESULT {
    uuid id PK
    uuid company_id FK
    uuid submission_id FK
    uuid document_id FK
    varchar validation_type
    varchar result
    varchar source_version
  }

  ACCOUNTING_ENTRY {
    uuid id PK
    uuid company_id FK
    date entry_date
    varchar source_type
    uuid source_id
    varchar status
  }

  ACCOUNTING_EXPENSE {
    uuid id PK
    uuid company_id FK
    uuid supplier_id FK
    varchar expense_type
    date expense_date
    varchar concept
    numeric total
    varchar evidence_type
    uuid evidence_file_asset_id FK
    varchar evidence_url
    varchar status
  }

  PAYROLL_SETTINGS {
    uuid id PK
    uuid company_id FK
    boolean electronic_payroll_enabled
  }

  WEB_SESSION {
    uuid id PK
    uuid user_id FK
    varchar session_token_hash
    varchar csrf_token_hash
    varchar status
    timestamp expires_at
  }

  AUDIT_EVENT {
    uuid id PK
    uuid company_id FK
    uuid user_id FK
    varchar event_type
    varchar resource_type
    varchar action
    varchar result
    timestamp occurred_at
  }

  OUTBOX_EVENT {
    uuid event_id PK
    uuid company_id FK
    varchar event_type
    varchar status
    timestamp occurred_at
  }

  INBOX_EVENT {
    uuid id PK
    uuid event_id
    uuid company_id FK
    varchar consumer
    varchar status
  }

  REPORT_DEFINITION {
    varchar code PK
    varchar label
    boolean date_range_required
    json allowed_chart_types
    json export_formats
    boolean active
  }

  REPORT_EXECUTION {
    uuid id PK
    uuid company_id FK
    varchar report_code FK
    date from_date
    date to_date
    json filters_json
    varchar status
  }

  REPORT_DATASET_CACHE {
    uuid id PK
    uuid company_id FK
    varchar report_code FK
    varchar cache_key
    json normalized_dataset
    timestamp created_at
    timestamp expires_at
  }

  REPORT_EXPORT_JOB {
    uuid id PK
    uuid company_id FK
    uuid requested_by_user_id
    varchar report_code
    varchar format
    varchar chart_type
    date from_date
    date to_date
    json filters_json
    boolean notify_by_email
    varchar token_hash
    timestamp token_expires_at
    varchar storage_key
    varchar filename
    varchar content_type
    bigint file_size
    varchar status
    varchar notification_status
    varchar failure_message
    timestamp requested_at
    timestamp started_at
    timestamp completed_at
    timestamp expires_at
  }

  REPORT_EXPORT_DOWNLOAD_ATTEMPT {
    uuid id PK
    uuid job_id FK
    uuid company_id FK
    timestamp attempted_at
    varchar result
    varchar detail
  }

  BUSINESS_HEALTH_SNAPSHOT {
    uuid id PK
    uuid company_id FK
    varchar sales_status
    varchar dian_status
    varchar storage_status
    varchar reporting_status
    timestamp evaluated_at
  }

  SERVICE_HEALTH_EVENT {
    uuid id PK
    uuid company_id FK
    varchar service_name
    varchar event_type
    varchar status
    varchar correlation_id
    timestamp occurred_at
  }
