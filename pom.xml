<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath />
    </parent>

    <groupId>com.msvanegasg.facturaelectronica</groupId>
    <artifactId>facturaelectronica-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>facturaelectronica-platform</name>
    <description>Factura electronica platform parent for physical microservices migration</description>

    <modules>
        <module>services/platform-eventing</module>
        <module>services/bff-service</module>
        <module>services/tenant-service</module>
        <module>services/identity-service</module>
        <module>services/catalog-service</module>
        <module>services/thirdparty-service</module>
        <module>services/inventory-service</module>
        <module>services/billing-service</module>
        <module>services/dian-provider-service</module>
        <module>services/accounting-service</module>
        <module>services/payroll-service</module>
        <module>services/audit-service</module>
        <module>services/audit-event-writer-lambda</module>
        <module>services/inventory-sale-effect-lambda</module>
        <module>services/accounting-sale-entry-lambda</module>
        <module>services/provider-submission-retry-lambda</module>
        <module>services/reporting-projection-lambda</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <springdoc.version>2.8.17</springdoc.version>
        <aws.sdk.version>2.29.6</aws.sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
