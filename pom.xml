<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.14</version>
		<relativePath />
	</parent>

	<groupId>com.msvanegasg.facturaelectronica</groupId>
	<artifactId>facturaelectronica-platform</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>facturaelectronica-platform</name>
	<description>Factura electronica platform parent for physical microservices migration</description>

	<modules>
		<module>services/tenant-service</module>
		<module>services/catalog-service</module>
		<module>services/thirdparty-service</module>
		<module>services/inventory-service</module>
		<module>services/billing-service</module>
		<module>services/dian-provider-service</module>
		<module>services/accounting-service</module>
		<module>services/audit-service</module>
	</modules>

	<properties>
		<java.version>17</java.version>
		<springdoc.version>2.8.17</springdoc.version>
	</properties>

	<profiles>
		<profile>
			<id>legacy-monolith</id>
			<modules>
				<module>services/legacy-monolith</module>
			</modules>
		</profile>
	</profiles>
</project>
